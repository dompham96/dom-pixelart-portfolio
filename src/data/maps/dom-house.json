  "npcs": [
    {
      "id": "ink_cat",
      "name": {
        "vi": "Mèo Ink",
        "en": "Ink the Cat"
      },
      "spriteKey": "ink_cat",
      "aiRole": "cat_companion",
      "x": 11,
      "y": 11,
      "facing": "down",
      "dialogue": [
        {
          "vi": "Meo~! Chào mừng bạn đi qua khu vườn vào nhà của Dom! Mình là Ink — hướng dẫn viên 4 chân.",
          "en": "Meow~! Welcome through the garden into Dom's house! I'm Ink — your four-legged tour guide."
        },
        {
          "vi": "Ngôi nhà dài lắm đó: từ Phòng khách trưng tranh, sang Bếp ấm cúng, rồi tới Phòng làm việc & Ngủ của Dom. Cứ đi dạo mình theo sau nhé!",
          "en": "It's a long cozy house: Living Room Gallery → Kitchen & Dining → Dom's Studio & Bedroom. Walk around and I'll tag along!"
        }
      ],
      "scheduleDialogues": {
        "follow": [
          {
            "vi": "Meo meo~ Mình đang lon ton đi theo bạn tham quan khắp nhà nè! Đừng quên ghé Bếp ăn và Phòng Studio phía đông nhé!",
            "en": "Meow meow~ I'm following you on the house tour! Don't miss the Kitchen and Dom's Studio to the east!"
          }
        ],
        "play_cat": [
          {
            "vi": "Purrrr~ Đang chơi đuổi bắt với Dom trên thảm vui quá! Lát chơi xong mình lại chạy theo bạn nhé meo~",
            "en": "Purrrr~ Playing with Dom on the studio rug! I'll follow you again right after playtime~"
          }
        ]
      },
      "actionButton": {
        "label": {
          "vi": "Xem nhanh toàn bộ tranh",
          "en": "Open Quick Gallery"
        },
        "actionType": "gallery"
      }
    },
    {
      "id": "dom",
      "name": {
        "vi": "Dom (Phú Sỹ)",
        "en": "Dom (Phú Sỹ)"
      },
      "spriteKey": "dom",
      "isHumanoid": true,
      "appearance": {
        "baseTone": "#faf3e8",
        "hairStyle": "short",
        "hairColor": "#382a26",
        "outfitStyle": "hoodie",
        "topColor": "#ffcf3d",
        "pantsColor": "#3a3836",
        "accessory": "cap",
        "accessoryColor": "#262322"
      },
      "aiRole": "dom_schedule",
      "x": 32,
      "y": 8,
      "facing": "up",
      "dialogue": [
        {
          "vi": "Chào bạn! Mình là Dom. Cảm ơn bạn đã dạo qua khu vườn để ghé căn nhà nhỏ này.",
          "en": "Hey there! I'm Dom. Thanks for strolling through the garden to visit my studio house."
        },
        {
          "vi": "Mỗi bức tranh ngoài hành lang phòng khách đều bắt đầu từ một chấm nhỏ (tiny dot). Nhớ ghé bảng Hậu Trường ngay trong phòng mình xem thêm nhé!",
          "en": "Every artwork in the gallery hall started from a tiny dot. Check out the Behind-the-Scenes board right here in my studio!"
        }
      ],
      "scheduleDialogues": {
        "sleep": [
          {
            "vi": "Khò... khò... Zzz... (03:00 – 09:00 là giờ ngủ sạc pin của Dom. Bạn cứ đi dạo xem tranh tự nhiên nhé!)",
            "en": "Zzz... (03:00 – 09:00 AM is Dom's recharge sleep window. Feel free to keep exploring the exhibition!)"
          }
        ],
        "work": [
          {
            "vi": "Chào bạn! Giờ hành chính (09:00 – 17:00) mình đang chấm từng pixel mới ở bàn làm việc đây.",
            "en": "Hey there! During studio hours (09:00 – 17:00), I'm right here crafting new pixels at my workbench."
          },
          {
            "vi": "Lát nữa mỏi tay mình hay đứng dậy chơi với Mèo Ink trên thảm — bạn nhớ ghé xem bảng Behind the Scenes ngay phía trên nhé!",
            "en": "Every now and then I take a break to play with Ink the Cat — check out the Behind-the-Scenes board right above my desk too!"
          }
        ],
        "play_cat": [
          {
            "vi": "Haha bắt được cục mực rồi nhé Ink! Nghỉ giải lao nựng mèo 5 phút lấy cảm hứng vẽ tiếp thôi~",
            "en": "Haha gotcha, Ink! Taking a quick cat-petting break for fresh creative inspiration~"
          }
        ],
        "gaming": [
          {
            "vi": "Sau 17:00 là hết giờ làm, tới giờ mình cày game indie thư giãn rồi! Chơi game cũng là cách mình học nhịp animation pixel đó.",
            "en": "Past 5:00 PM means off-the-clock indie gaming time! Playing pixel games is secretly how I study cozy animation too."
          }
        ]
      },
      "actionButton": {
        "label": {
          "vi": "Đọc thêm về Dom",
          "en": "Read Full Bio"
        },
        "actionType": "about"
      }
    },
