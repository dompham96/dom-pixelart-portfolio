      "x": 12,
      "y": 10,
      "facing": "down",
      "dialogue": [
        {
          "vi": "Meo~! Chào mừng bạn ghé thăm nhà của Dom! Mình là Ink — chủ nhà kiêm hướng dẫn viên 4 chân.",
          "en": "Meow~! Welcome to Dom's house! I'm Ink — four-legged host and tour guide."
        },
        {
          "vi": "Cứ đi dạo từ phòng khách sang phòng làm việc và bếp nhé, mình sẽ lon ton đi theo bạn!",
          "en": "Feel free to wander from the gallery into the studio and kitchen — I'll tag right along!"
        }
      ],
      "scheduleDialogues": {
        "follow": [
          {
            "vi": "Meo meo~ Mình đi theo bạn tham quan khắp nhà nè! Phòng khách có 8 bộ tranh, bên phải còn có phòng ngủ, bàn vẽ và bếp của Dom nữa đó.",
            "en": "Meow meow~ I'm following you on the house tour! Check out the 8 gallery frames, plus Dom's studio, bedroom, and kitchen to the east!"
          }
        ],
        "play_cat": [
          {
            "vi": "Purrrr~ Đang chơi đuổi bắt với Dom vui quá! Lát chơi xong mình lại chạy theo bạn nhé meo~",
            "en": "Purrrr~ Playing with Dom right now! I'll come follow you again right after playtime~"
          }
        ]
      },
      "actionButton": {
        "label": { "vi": "Xem nhanh toàn bộ tranh", "en": "Open Quick Gallery" },
        "actionType": "gallery"
      }
    },
    {
      "id": "dom",
      "name": { "vi": "Dom (Phú Sỹ)", "en": "Dom (Phú Sỹ)" },
      "spriteKey": "dom",
      "isHumanoid": true,
      "appearance": {
        "baseTone": "#faf3e8",
        "hairStyle": "short",
        "hairColor": "#382a26",
        "outfitStyle": "hoodie",
        "topColor": "#ffcf3d",
        "pantsColor": "#3a3836",
        "accessory": "cap",
        "accessoryColor": "#262322"
      },
      "aiRole": "dom_schedule",
      "x": 21,
      "y": 5,
      "facing": "up",
      "dialogue": [
        {
          "vi": "Chào bạn! Mình là Dom. Cảm ơn bạn đã gác bộn bề lại để ghé căn nhà nhỏ này.",
          "en": "Hey there! I'm Dom. Thanks for pausing your busy day to visit my little pixel house."
        },
        {
          "vi": "Mỗi bức tranh ngoài phòng khách đều bắt đầu từ một chấm nhỏ (tiny dot). Nhớ ghé bảng Hậu Trường trong phòng mình xem thêm nhé!",
          "en": "Every artwork in the gallery started from a tiny dot. Check out the Behind-the-Scenes board right here in my studio!"
        }
      ],
      "scheduleDialogues": {
        "sleep": [
          {
            "vi": "Khò... khò... Zzz... (03:00 – 09:00 là giờ ngủ sạc pin của Dom. Bạn cứ đi dạo xem tranh tự nhiên nhé!)",
            "en": "Zzz... (03:00 – 09:00 AM is Dom's recharge sleep window. Feel free to keep exploring the exhibition!)"
          }
        ],
        "work": [
          {
            "vi": "Chào bạn! Giờ hành chính (09:00 – 17:00) mình đang chấm từng pixel mới ở bàn vẽ đây.",
            "en": "Hey there! During studio hours (09:00 – 17:00), I'm right here crafting new pixels at my desk."
